#include <windows.h>
1 24 "@CMAKE_SOURCE_DIR@/src/app.manifest"
201 RCDATA "@CMAKE_SOURCE_DIR@/web/index.html"
202 RCDATA "@CMAKE_SOURCE_DIR@/web/app.css"
203 RCDATA "@CMAKE_SOURCE_DIR@/web/app.js"
204 RCDATA "@CMAKE_SOURCE_DIR@/web/audio-worklet.js"
205 RCDATA "@CMAKE_SOURCE_DIR@/web/audio-playback.js"
207 RCDATA "@CMAKE_SOURCE_DIR@/web/control-core.js"
206 DIALOGEX 0, 0, 340, 166
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Web server passcode"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Choose the passcode used to sign in to the web dashboard. Use 8 to 64 characters.", -1, 12, 12, 316, 24
  LTEXT "Passcode", -1, 12, 42, 60, 12
  EDITTEXT 1001, 12, 57, 316, 16, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
  AUTOCHECKBOX "Show passcode", 1002, 12, 80, 130, 14, WS_TABSTOP
  PUSHBUTTON "Generate random", 1003, 224, 78, 104, 20
  LTEXT "Saving a changed passcode signs out browsers. Sign in again with the new passcode.", -1, 12, 102, 316, 24
  DEFPUSHBUTTON "Save", IDOK, 172, 134, 74, 22
  PUSHBUTTON "Cancel", IDCANCEL, 254, 134, 74, 22
END
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILETYPE 1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "FT-710 Dashboard - M0NXD\0"
      VALUE "ProductName", "FT-710 Dashboard\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
